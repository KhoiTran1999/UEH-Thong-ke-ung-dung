        <mxCell id="CROSS_E3_E5" edge="1" parent="1" source="E3_HEADER" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0D47A1;strokeWidth=2;fontSize=10;fontFamily=Helvetica;curved=0;exitX=1;exitY=0.5;entryX=0.25;entryY=0;labelBackgroundColor=#ffffff;spacing=4;" target="E5_HEADER" value="Trực quan hóa hiện trạng điều hành&lt;br/&gt;Kiểm soát chất lượng (SQC x̄-chart)">
