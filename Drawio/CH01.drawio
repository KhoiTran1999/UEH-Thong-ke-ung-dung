        <mxCell id="CROSS_E2_E1" edge="1" parent="1" source="E2_HEADER" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#00838F;strokeWidth=2;fontSize=10;fontFamily=Helvetica;curved=0;exitX=0;exitY=0.5;entryX=1;entryY=0.5;labelBackgroundColor=#ffffff;spacing=4;" target="E1_HEADER" value="Cung cấp dữ liệu thô (Sơ cấp &amp;amp; Thứ cấp)&lt;br/&gt;Chuẩn hóa cấu trúc &amp;amp; Hệ thống 4 thang đo">
          <mxGeometry relative="1" as="geometry" />
