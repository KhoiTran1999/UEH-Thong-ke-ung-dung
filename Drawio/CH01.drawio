        <mxCell id="CROSS_E1_E4" edge="1" parent="1" source="E1_HEADER" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#37474F;strokeWidth=2;dashed=1;fontSize=10;fontFamily=Helvetica;curved=0;exitX=1;exitY=0.8;entryX=0;entryY=0.35;labelBackgroundColor=#ffffff;spacing=4;" target="E4_HEADER" value="Cung cấp dữ liệu mẫu đại diện (Sample n)&lt;br/&gt;Ước lượng tham số tổng thể (μ, N)">
