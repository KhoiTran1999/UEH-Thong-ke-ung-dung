        <mxCell id="CROSS_E1_E3" edge="1" parent="1" source="E1_HEADER" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#37474F;strokeWidth=2;fontSize=10;fontFamily=Helvetica;curved=0;exitX=0;exitY=0.5;entryX=0;entryY=0.5;labelBackgroundColor=#ffffff;spacing=4;" target="E3_HEADER" value="Cung cấp tập dữ liệu (Data Set)&lt;br/&gt;Tổ chức bảng biểu &amp;amp; Đồ thị mô tả">
          <mxGeometry relative="1" as="geometry">
