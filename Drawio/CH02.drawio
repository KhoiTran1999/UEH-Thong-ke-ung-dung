<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="Electron">
  <diagram name="Thống kê ứng dụng - Chương 2: Thống kê mô tả - Bảng &amp; Đồ thị" id="CH02-DescriptiveTabularGraphical-Mindmap">
    <mxGraphModel dx="1628" dy="-1422" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ========================================== -->
        <!-- TOP TITLE BANNER                           -->
        <!-- ========================================== -->
        <mxCell id="TITLE_BANNER" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#1e293b;strokeColor=#0f172a;strokeWidth=2;fontColor=#ffffff;align=center;verticalAlign=middle;shadow=1;fontFamily=Helvetica;" vertex="1">
          <mxGeometry height="90" width="2000" x="1200" y="100" as="geometry" />
        </mxCell>
        <mxCell id="TITLE_TEXT" parent="1" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=#ffffff;fontSize=22;fontStyle=1;" value="CHƯƠNG 2: THỐNG KÊ MÔ TẢ: TRÌNH BÀY BẰNG BẢNG &amp; ĐỒ THỊ&lt;br/&gt;&lt;span style=&quot;font-size: 13px; font-weight: normal; opacity: 0.85; color: #94a3b8;&quot;&gt;Entity-based &amp; Hierarchical Systems Thinking Mindmap | Thống kê Ứng dụng UEH | Chuẩn giáo trình Anderson, Sweeney, Williams&lt;/span&gt;" vertex="1">
          <mxGeometry height="70" width="1960" x="1220" y="110" as="geometry" />
        </mxCell>

        <!-- ========================================== -->
        <!-- TIER 1: INPUT FILTERS & CATEGORICAL ENGINE -->
        <!-- Left: [E1] Scale Filter | Right: [E3] Categorical Engine -->
        <!-- ========================================== -->

        <!-- [E1] DỮ LIỆU & ĐIỀU KIỆN THANG ĐO -->
        <mxCell id="E1_HEADER" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#37474F;strokeColor=#212121;fontColor=#ffffff;fontStyle=1;fontSize=13;shadow=1;fontFamily=Helvetica;" value="📊 [E1] DỮ LIỆU &amp; ĐIỀU KIỆN THANG ĐO (DATA &amp; SCALE FILTER)&lt;br/&gt;&lt;span style=&quot;opacity: 0.85; font-size: 11px; font-weight: normal;&quot;&gt;Quy chuẩn Thang đo (Nominal/Ordinal vs Interval/Ratio) quyết định công cụ hiển thị&lt;/span&gt;" vertex="1">
          <mxGeometry height="55" width="400" x="1400" y="240" as="geometry" />
        </mxCell>

        <mxCell id="E1_CARD_1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ECEFF1;strokeColor=#546E7A;strokeWidth=1.5;fontColor=#263238;fontSize=11;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;fontFamily=Helvetica;" value="&lt;b style=&quot;font-size: 12px; color: #1A237E;&quot;&gt;1.1 🎯 NGUYÊN TẮC ÁNH XẠ THANG ĐO &amp; PHÂN NHÓM:&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Thang đo quyết định công cụ&lt;/b&gt;: Nominal/Ordinal dùng Bar/Pie/Crosstab; Interval/Ratio dùng Histogram/Dot/Ogive/Scatter&lt;br/&gt;• &lt;b&gt;Điều cấm kỵ&lt;/b&gt;: Tuyệt đối không vẽ Histogram cho dữ liệu định tính; không tính Mean cho mã danh nghĩa&lt;br/&gt;• &lt;b&gt;Dữ liệu thô vs Phân nhóm&lt;/b&gt;: Chuyển đổi từ số liệu rời rạc sang phân phối có tổ chức&lt;br/&gt;• &lt;b&gt;Vai trò bộ lọc (Filter)&lt;/b&gt;: Bước thẩm định bắt buộc trước khi chọn dạng bảng hoặc đồ thị" vertex="1">
          <mxGeometry height="180" width="340" x="1060" y="340" as="geometry" />
        </mxCell>

        <mxCell id="E1_CARD_2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ECEFF1;strokeColor=#546E7A;strokeWidth=1.5;fontColor=#263238;fontSize=11;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;fontFamily=Helvetica;" value="&lt;b style=&quot;font-size: 12px; color: #1A237E;&quot;&gt;1.2 ⚙️ BỘ ĐÔI SỐ TUYỆT ĐỐI &amp; SỐ TƯƠNG ĐỐI:&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Tần số (Frequency, f)&lt;/b&gt;: Số phần tử trong nhóm; phản ánh quy mô tuyệt đối nhưng che khuất tỷ trọng&lt;br/&gt;• &lt;b&gt;Tần suất (Relative Freq, rf)&lt;/b&gt;: rf = f / n; tỷ lệ tương đối; tổng các rf luôn bằng 1.00&lt;br/&gt;• &lt;b&gt;Tần suất phần trăm (Percent Freq, pf)&lt;/b&gt;: pf = rf × 100%; trực quan phục vụ so sánh giữa các tập dữ liệu có quy mô n khác nhau&lt;br/&gt;• &lt;b&gt;Bẫy so sánh quy mô&lt;/b&gt;: Không so sánh hai tổng thể bằng tần số thô khi cỡ mẫu n1 ≠ n2" vertex="1">
          <mxGeometry height="180" width="340" x="1430" y="340" as="geometry" />
        </mxCell>

        <mxCell id="E1_CARD_3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ECEFF1;strokeColor=#546E7A;strokeWidth=1.5;fontColor=#263238;fontSize=11;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;fontFamily=Helvetica;" value="&lt;b style=&quot;font-size: 12px; color: #1A237E;&quot;&gt;1.3 ⚠️ THIẾT KẾ ĐỒ THỊ CHUẨN MỰC (DATA-INK RATIO):&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Nguyên tắc Edward Tufte&lt;/b&gt;: Tối đa hóa tỷ lệ dữ liệu/mực (Data-ink ratio), loại bỏ trang trí rác (Chartjunk)&lt;br/&gt;• &lt;b&gt;Quy chuẩn trục tọa độ&lt;/b&gt;: Trục tung bắt đầu từ gốc 0 để tránh phóng đại sai lệch trực giác thị giác&lt;br/&gt;• &lt;b&gt;Ranh giới trực quan&lt;/b&gt;: Cột tách rời (Bar chart) cho định tính vs Cột liền kề (Histogram) cho định lượng&lt;br/&gt;• &lt;b&gt;Độ rộng cột&lt;/b&gt;: Cố định bằng nhau để tránh đánh lừa diện tích thị giác người xem" vertex="1">
          <mxGeometry height="180" width="340" x="1800" y="340" as="geometry" />
        </mxCell>

        <!-- E1 Internal Hierarchy Edges -->
        <mxCell id="E1_EDGE_1" edge="1" parent="1" source="E1_HEADER" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#37474F;strokeWidth=1.5;curved=0;exitX=0.2;exitY=1;entryX=0.5;entryY=0;" target="E1_CARD_1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="E1_EDGE_2" edge="1" parent="1" source="E1_HEADER" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#37474F;strokeWidth=1.5;curved=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="E1_CARD_2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="E1_EDGE_3" edge="1" parent="1" source="E1_HEADER" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#37474F;strokeWidth=1.5;curved=0;exitX=0.8;exitY=1;entryX=0.5;entryY=0;" target="E1_CARD_3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- [E3] PHƯƠNG PHÁP BẢNG & ĐỒ THỊ ĐỊNH TÍNH -->
        <mxCell id="E3_HEADER" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#0D47A1;strokeColor=#1565C0;fontColor=#ffffff;fontStyle=1;fontSize=13;shadow=1;fontFamily=Helvetica;" value="📋 [E3] PHƯƠNG PHÁP BẢNG &amp; ĐỒ THỊ ĐỊNH TÍNH (CATEGORICAL ENGINE)&lt;br/&gt;&lt;span style=&quot;opacity: 0.85; font-size: 11px; font-weight: normal;&quot;&gt;Tổ chức Tần số, Tần suất, Biểu đồ Thanh, Biểu đồ Pareto &amp; Biểu đồ Tròn&lt;/span&gt;" vertex="1">
          <mxGeometry height="55" width="420" x="2590" y="240" as="geometry" />
        </mxCell>

        <mxCell id="E3_CARD_1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E3F2FD;strokeColor=#1E88E5;strokeWidth=1.5;fontColor=#0D47A1;fontSize=11;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;fontFamily=Helvetica;" value="&lt;b style=&quot;font-size: 12px; color: #0D47A1;&quot;&gt;2.1 🎯 BẢNG PHÂN PHỐI TẦN SỐ &amp; TẦN SUẤT ĐỊNH TÍNH:&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Cấu trúc bảng&lt;/b&gt;: Danh mục nhóm (Categories) | Tần số (f) | Tần suất (rf) | Tần suất % (pf)&lt;br/&gt;• &lt;b&gt;Quy tắc thứ tự&lt;/b&gt;: Nominal xếp theo chữ cái hoặc tần số giảm; Ordinal BẮT BUỘC giữ nguyên thứ tự cấp bậc (Kém → Tốt)&lt;br/&gt;• &lt;b&gt;Ví dụ nước giải khát&lt;/b&gt;: 50 khách mua 5 nhãn (Coke 19, Diet Coke 8, Dr. Pepper 5, Pepsi 13, Sprite 5)&lt;br/&gt;• &lt;b&gt;Nhóm ngoại lệ&lt;/b&gt;: Gom các nhóm nhỏ có tần suất cực thấp (&lt; 1-2%) vào danh mục 'Khác' (Other)" vertex="1">
          <mxGeometry height="180" width="340" x="2260" y="340" as="geometry" />
        </mxCell>

        <mxCell id="E3_CARD_2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E3F2FD;strokeColor=#1E88E5;strokeWidth=1.5;fontColor=#0D47A1;fontSize=11;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;fontFamily=Helvetica;" value="&lt;b style=&quot;font-size: 12px; color: #0D47A1;&quot;&gt;2.2 ⚙️ BIỂU ĐỒ THANH (BAR CHART) &amp; BIỂU ĐỒ PARETO:&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Biểu đồ thanh&lt;/b&gt;: Trục hoành danh mục, trục tung f hoặc %; các thanh CÁCH RỜI NHAU rõ ràng; độ rộng thanh bằng nhau&lt;br/&gt;• &lt;b&gt;Biểu đồ Pareto&lt;/b&gt;: Biểu đồ thanh sắp xếp các nhóm theo thứ tự TẦN SỐ GIẢM DẦN từ trái sang phải, kèm đường tích lũy %&lt;br/&gt;• &lt;b&gt;Nguyên lý 80/20 của Pareto&lt;/b&gt;: 80% lỗi hỏng/doanh số bắt nguồn từ 20% nguyên nhân then chốt ('vital few' vs 'trivial many')&lt;br/&gt;• &lt;b&gt;Ứng dụng điều hành&lt;/b&gt;: Giúp ban quản lý định vị nguyên nhân ưu tiên cần tập trung xử lý" vertex="1">
          <mxGeometry height="180" width="340" x="2630" y="340" as="geometry" />
        </mxCell>

        <mxCell id="E3_CARD_3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E3F2FD;strokeColor=#1E88E5;strokeWidth=1.5;fontColor=#0D47A1;fontSize=11;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;fontFamily=Helvetica;" value="&lt;b style=&quot;font-size: 12px; color: #0D47A1;&quot;&gt;2.3 ⚠️ BIỂU ĐỒ TRÒN (PIE CHART) &amp; NGUY CƠ BÓP MÉO:&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Bản chất&lt;/b&gt;: Biểu diễn cơ cấu tỷ trọng tương đối trong tổng thể 100% (1.00 tương ứng hình tròn 360 độ)&lt;br/&gt;• &lt;b&gt;Góc hình quạt&lt;/b&gt;: Góc tâm = rf × 360° (Ví dụ Coke 38% = 0.38 × 360° = 136.8°)&lt;br/&gt;• &lt;b&gt;Ranh giới áp dụng&lt;/b&gt;: Chỉ dùng khi số nhóm nhỏ (&lt; 5-7 nhóm); nhiều nhóm sẽ gây rối mắt, khó phân biệt diện tích&lt;br/&gt;• &lt;b&gt;Cấm kỵ 3D Pie Chart&lt;/b&gt;: Hiệu ứng không gian 3 chiều làm méo mó góc nhìn và đánh lừa thị giác người xem" vertex="1">
          <mxGeometry height="180" width="340" x="3000" y="340" as="geometry" />
        </mxCell>

        <!-- E3 Internal Hierarchy Edges -->
        <mxCell id="E3_EDGE_1" edge="1" parent="1" source="E3_HEADER" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0D47A1;strokeWidth=1.5;curved=0;exitX=0.2;exitY=1;entryX=0.5;entryY=0;" target="E3_CARD_1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="E3_EDGE_2" edge="1" parent="1" source="E3_HEADER" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0D47A1;strokeWidth=1.5;curved=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="E3_CARD_2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="E3_EDGE_3" edge="1" parent="1" source="E3_HEADER" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0D47A1;strokeWidth=1.5;curved=0;exitX=0.8;exitY=1;entryX=0.5;entryY=0;" target="E3_CARD_3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ========================================== -->
        <!-- TIER 2: ADVANCED ENGINES                   -->
        <!-- Left: [E6] Quantitative | Right: [E7] Bivariate & Simpson -->
        <!-- ========================================== -->

        <!-- [E6] PHƯƠNG PHÁP BẢNG & ĐỒ THỊ ĐỊNH LƯỢNG -->
        <mxCell id="E6_HEADER" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#006064;strokeColor=#00838F;fontColor=#ffffff;fontStyle=1;fontSize=13;shadow=1;fontFamily=Helvetica;" value="📈 [E6] PHƯƠNG PHÁP BẢNG &amp; ĐỒ THỊ ĐỊNH LƯỢNG (QUANTITATIVE ENGINE)&lt;br/&gt;&lt;span style=&quot;opacity: 0.85; font-size: 11px; font-weight: normal;&quot;&gt;Quy trình 3 Bước Lập lớp, Histogram, Dot plot, Ogive &amp; Đồ thị Nhánh - Lá&lt;/span&gt;" vertex="1">
          <mxGeometry height="55" width="420" x="1390" y="600" as="geometry" />
        </mxCell>

        <mxCell id="E6_CARD_1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=1.5;fontColor=#004D40;fontSize=11;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;fontFamily=Helvetica;" value="&lt;b style=&quot;font-size: 12px; color: #006064;&quot;&gt;3.1 🎯 QUY TRÌNH 3 BƯỚC THIẾT KẾ BẢNG PHÂN PHỐI LỚP:&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Bước 1 - Số lớp (k)&lt;/b&gt;: Chọn k từ 5 đến 20; quy tắc kinh nghiệm 2^k ≥ n (mẫu n = 20 kiểm toán chọn k = 5)&lt;br/&gt;• &lt;b&gt;Bước 2 - Độ rộng lớp (Width)&lt;/b&gt;: Width ≈ (Max - Min) / k, làm tròn số nguyên tiện dụng (Ví dụ: (33-12)/5 = 4.2 → 5 ngày)&lt;br/&gt;• &lt;b&gt;Bước 3 - Giới hạn lớp (Class Limits)&lt;/b&gt;: Không chồng lấn, đóng mở rõ ràng (10–14, 15–19); Trung điểm lớp = (Dưới + Trên) / 2&lt;br/&gt;• &lt;b&gt;Case Sanderson &amp; Clifford&lt;/b&gt;: 20 khách hàng kiểm toán từ 12-33 ngày phân thành 5 lớp bề rộng 5 ngày" vertex="1">
          <mxGeometry height="180" width="340" x="1060" y="700" as="geometry" />
        </mxCell>

        <mxCell id="E6_CARD_2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=1.5;fontColor=#004D40;fontSize=11;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;fontFamily=Helvetica;" value="&lt;b style=&quot;font-size: 12px; color: #006064;&quot;&gt;3.2 ⚙️ BIỂU ĐỒ HISTOGRAM, ĐỒ THỊ ĐIỂM (DOT PLOT):&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Đồ thị điểm (Dot plot)&lt;/b&gt;: Mỗi quan sát là 1 chấm tròn trên trục số; trùng nhau xếp chồng thẳng đứng; thấy rõ giá trị thô &amp; độ phân tán&lt;br/&gt;• &lt;b&gt;Histogram&lt;/b&gt;: Các cột LIỀN KỀ NHAU (không khoảng cách); chiều cao là tần số/tần suất; diện tích cột tỷ lệ với tần số&lt;br/&gt;• &lt;b&gt;Nhận diện hình dáng phân phối&lt;/b&gt;:&lt;br/&gt;  + &lt;i&gt;Đối xứng (Symmetric)&lt;/i&gt;: Hình chuông chuẩn quanh trung tâm&lt;br/&gt;  + &lt;i&gt;Lệch phải / Lệch dương (Skewed right)&lt;/i&gt;: Đuôi dài bên phải (thu nhập, giá nhà)&lt;br/&gt;  + &lt;i&gt;Lệch trái / Lệch âm (Skewed left)&lt;/i&gt;: Đuôi dài bên trái (điểm thi dễ)" vertex="1">
          <mxGeometry height="180" width="340" x="1430" y="700" as="geometry" />
        </mxCell>

        <mxCell id="E6_CARD_3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=1.5;fontColor=#004D40;fontSize=11;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;fontFamily=Helvetica;" value="&lt;b style=&quot;font-size: 12px; color: #006064;&quot;&gt;3.3 ⚠️ PHÂN PHỐI TÍCH LŨY (OGIVE) &amp; NHÁNH - LÁ:&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Phân phối tích lũy&lt;/b&gt;: Cộng dồn tần số/tần suất các lớp trước (cho biết số phần tử 'nhỏ hơn hoặc bằng' giới hạn trên)&lt;br/&gt;• &lt;b&gt;Đồ thị Ogive&lt;/b&gt;: Đường cong tích lũy; bắt đầu từ giới hạn dưới lớp 1 tại 0, nối các điểm tại giới hạn trên từng lớp&lt;br/&gt;• &lt;b&gt;Đồ thị Nhánh - Lá (Stem-and-Leaf)&lt;/b&gt;: Tách số thành Thân (chục/trăm) và Lá (đơn vị); vừa xếp thứ tự vừa thấy hình dáng phân phối&lt;br/&gt;• &lt;b&gt;Ưu thế vượt trội&lt;/b&gt;: GIỮ NGUYÊN 100% SỐ THÔ; kỹ thuật kéo giãn thân (Stretched Stem) khi lá quá dài" vertex="1">
          <mxGeometry height="180" width="340" x="1800" y="700" as="geometry" />
        </mxCell>

        <!-- E6 Internal Hierarchy Edges -->
        <mxCell id="E6_EDGE_1" edge="1" parent="1" source="E6_HEADER" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#006064;strokeWidth=1.5;curved=0;exitX=0.2;exitY=1;entryX=0.5;entryY=0;" target="E6_CARD_1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="E6_EDGE_2" edge="1" parent="1" source="E6_HEADER" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#006064;strokeWidth=1.5;curved=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="E6_CARD_2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="E6_EDGE_3" edge="1" parent="1" source="E6_HEADER" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#006064;strokeWidth=1.5;curved=0;exitX=0.8;exitY=1;entryX=0.5;entryY=0;" target="E6_CARD_3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- [E7] PHÂN TÍCH ĐA BIẾN & NGHỊCH LÝ SIMPSON -->
        <mxCell id="E7_HEADER" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#BF360C;strokeColor=#E65100;fontColor=#ffffff;fontStyle=1;fontSize=13;shadow=1;fontFamily=Helvetica;" value="🔄 [E7] PHÂN TÍCH ĐA BIẾN &amp; NGHỊCH LÝ SIMPSON (BIVARIATE &amp; SIMPSON)&lt;br/&gt;&lt;span style=&quot;opacity: 0.85; font-size: 11px; font-weight: normal;&quot;&gt;Bảng chéo (Crosstabulation), Đồ thị phân tán (Scatter) &amp; Bẫy Biến ẩn&lt;/span&gt;" vertex="1">
          <mxGeometry height="55" width="420" x="2590" y="600" as="geometry" />
        </mxCell>

        <mxCell id="E7_CARD_1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FBE9E7;strokeColor=#FF7043;strokeWidth=1.5;fontColor=#BF360C;fontSize=11;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;fontFamily=Helvetica;" value="&lt;b style=&quot;font-size: 12px; color: #BF360C;&quot;&gt;4.1 🎯 BẢNG CHÉO (CROSSTABULATION / CONTINGENCY):&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Bản chất&lt;/b&gt;: Bảng 2 chiều tóm tắt đồng thời quan hệ giữa 2 biến (Định tính - Định tính, Định tính - Định lượng, Định lượng - Định lượng)&lt;br/&gt;• &lt;b&gt;Ô trung tâm (Cells)&lt;/b&gt;: Tần số xuất hiện đồng thời; Bảng biên (Marginal): Tổng dòng và Tổng cột (phân phối đơn của từng biến)&lt;br/&gt;• &lt;b&gt;Chuyển đổi tỷ lệ&lt;/b&gt;: Phần trăm theo dòng (Row %) so sánh giữa các dòng; Phần trăm theo cột (Col %) so sánh giữa các cột&lt;br/&gt;• &lt;b&gt;Minh họa&lt;/b&gt;: Bảng chéo Kiểu nhà (Colonial, Log...) và Khoảng giá (&lt; 150k, 150-200k, &gt; 200k)" vertex="1">
          <mxGeometry height="180" width="340" x="2260" y="700" as="geometry" />
        </mxCell>

        <mxCell id="E7_CARD_2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FBE9E7;strokeColor=#FF7043;strokeWidth=1.5;fontColor=#BF360C;fontSize=11;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;fontFamily=Helvetica;" value="&lt;b style=&quot;font-size: 12px; color: #BF360C;&quot;&gt;4.2 ⚙️ NGHỊCH LÝ SIMPSON &amp; BIẾN ẨN (CONFOUNDING):&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Bản chất&lt;/b&gt;: Kết luận rút ra từ bảng chéo gộp chung (Aggregated Data) bị ĐẢO NGƯỢC HOÀN TOÀN khi tách ra phân tích theo biến thứ 3&lt;br/&gt;• &lt;b&gt;Biến ẩn / Biến can thiệp (Confounding Variable)&lt;/b&gt;: Biến bị bỏ sót nhưng chi phối mạnh mẽ cả 2 biến đang nghiên cứu&lt;br/&gt;• &lt;b&gt;Case 2 Bác sĩ&lt;/b&gt;: Bác sĩ A giỏi hơn ở cả ca nhẹ (99% &gt; 98%) và ca nặng (80% &gt; 70%), nhưng tỷ lệ gộp lại thấp hơn Bác sĩ B (84% &lt; 90%) do A gánh hầu hết ca hiểm nghèo!&lt;br/&gt;• &lt;b&gt;Bài học quản trị&lt;/b&gt;: Không ra quyết định chỉ dựa trên bảng số liệu gộp" vertex="1">
          <mxGeometry height="180" width="340" x="2630" y="700" as="geometry" />
        </mxCell>

        <mxCell id="E7_CARD_3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FBE9E7;strokeColor=#FF7043;strokeWidth=1.5;fontColor=#BF360C;fontSize=11;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;fontFamily=Helvetica;" value="&lt;b style=&quot;font-size: 12px; color: #BF360C;&quot;&gt;4.3 ⚠️ ĐỒ THỊ PHÂN TÁN (SCATTER) &amp; ĐƯỜNG XU HƯỚNG:&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Đồ thị phân tán (Scatter diagram)&lt;/b&gt;: Biểu diễn quan hệ giữa 2 biến định lượng trên tọa độ Descartes (x độc lập, y phụ thuộc)&lt;br/&gt;• &lt;b&gt;Nhận diện dạng quan hệ&lt;/b&gt;: Tuyến tính dương (cùng tăng), Tuyến tính âm (nghịch biến), Không tương quan, Quan hệ phi tuyến&lt;br/&gt;• &lt;b&gt;Đường xu hướng (Trendline)&lt;/b&gt;: Đường xấp xỉ tốt nhất; mở đầu nền tảng cho mô hình Hồi quy tuyến tính (Chương 14)&lt;br/&gt;• &lt;b&gt;Minh họa Panther Products&lt;/b&gt;: Chi phí quảng cáo trên TV và Doanh số bán hàng điện tử âm thanh" vertex="1">
          <mxGeometry height="180" width="340" x="3000" y="700" as="geometry" />
        </mxCell>

        <!-- E7 Internal Hierarchy Edges -->
        <mxCell id="E7_EDGE_1" edge="1" parent="1" source="E7_HEADER" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#BF360C;strokeWidth=1.5;curved=0;exitX=0.2;exitY=1;entryX=0.5;entryY=0;" target="E7_CARD_1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="E7_EDGE_2" edge="1" parent="1" source="E7_HEADER" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#BF360C;strokeWidth=1.5;curved=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="E7_CARD_2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="E7_EDGE_3" edge="1" parent="1" source="E7_HEADER" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#BF360C;strokeWidth=1.5;curved=0;exitX=0.8;exitY=1;entryX=0.5;entryY=0;" target="E7_CARD_3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ========================================== -->
        <!-- TIER 3: BUSINESS & VISUALIZATION PILLARS   -->
        <!-- Center Spanning: [E5] Managerial Decisions -->
        <!-- ========================================== -->

        <!-- [E5] TRỤ CỘT ỨNG DỤNG QUẢN TRỊ & THỊ GIÁC DỮ LIỆU -->
        <mxCell id="E5_HEADER" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#1B5E20;strokeColor=#2E7D32;fontColor=#ffffff;fontStyle=1;fontSize=13;shadow=1;fontFamily=Helvetica;" value="💼 [E5] TRỤ CỘT ỨNG DỤNG QUẢN TRỊ &amp; THỊ GIÁC DỮ LIỆU (BUSINESS PILLARS)&lt;br/&gt;&lt;span style=&quot;opacity: 0.85; font-size: 11px; font-weight: normal;&quot;&gt;Kiểm soát Chất lượng (SQC), Tối ưu Pareto, Phân tích Thị phần &amp; Đạo đức Đồ họa&lt;/span&gt;" vertex="1">
          <mxGeometry height="55" width="480" x="1960" y="960" as="geometry" />
        </mxCell>

        <mxCell id="E5_CARD_1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E8F5E9;strokeColor=#43A047;strokeWidth=1.5;fontColor=#1B5E20;fontSize=11;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;fontFamily=Helvetica;" value="&lt;b style=&quot;font-size: 12px; color: #1B5E20;&quot;&gt;5.1 🎯 KIỂM SOÁT CHẤT LƯỢNG (SQC) &amp; TỐI ƯU HÓA PARETO:&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Sản xuất / SQC&lt;/b&gt;: Biểu đồ Histogram giám sát dung sai quy trình sản xuất (nồng độ dung dịch, khối lượng đóng gói); phân phối lệch/bẹt cảnh báo máy móc trục trặc&lt;br/&gt;• &lt;b&gt;Quản trị chất lượng toàn diện (TQM)&lt;/b&gt;: Biểu đồ Pareto định vị 20% khâu lỗi gây ra 80% phế phẩm, hướng dẫn phân bổ chính xác nguồn lực sửa chữa&lt;br/&gt;• &lt;b&gt;Tiếp thị &amp; Bán lẻ&lt;/b&gt;: Biểu đồ thanh và biểu đồ tròn phân tích cơ cấu thị phần sản phẩm và nhóm khách hàng mục tiêu" vertex="1">
          <mxGeometry height="180" width="380" x="1600" y="1060" as="geometry" />
        </mxCell>

        <mxCell id="E5_CARD_2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E8F5E9;strokeColor=#43A047;strokeWidth=1.5;fontColor=#1B5E20;fontSize=11;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;fontFamily=Helvetica;" value="&lt;b style=&quot;font-size: 12px; color: #1B5E20;&quot;&gt;5.2 ⚙️ PHÂN TÍCH ĐA BIẾN TRONG TÀI CHÍNH &amp; VẬN HÀNH:&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Tài chính / Đầu tư&lt;/b&gt;: Đồ thị phân tán (Scatter diagram) khảo sát quan hệ giữa Tỷ suất sinh lời và Rủi ro (Độ lệch chuẩn); giữa P/E và Tốc độ tăng trưởng EPS&lt;br/&gt;• &lt;b&gt;Kiểm toán &amp; Thuế&lt;/b&gt;: Đồ thị Ogive và biểu đồ tích lũy xác định tỷ lệ hồ sơ kiểm toán hoàn thành đúng hạn (80% hồ sơ hoàn tất trong 25 ngày)&lt;br/&gt;• &lt;b&gt;Quản trị nhân sự &amp; Y tế&lt;/b&gt;: Áp dụng bảng chéo kiểm soát phân công nhân sự, triệt tiêu sai lầm đánh giá năng lực do Nghịch lý Simpson" vertex="1">
          <mxGeometry height="180" width="380" x="2010" y="1060" as="geometry" />
        </mxCell>

        <mxCell id="E5_CARD_3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E8F5E9;strokeColor=#43A047;strokeWidth=1.5;fontColor=#1B5E20;fontSize=11;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;fontFamily=Helvetica;" value="&lt;b style=&quot;font-size: 12px; color: #1B5E20;&quot;&gt;5.3 ⚠️ NGUYÊN TẮC ĐẠO ĐỨC &amp; TRỰC QUAN HÓA TRUNG THỰC:&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Đạo đức hiển thị số liệu&lt;/b&gt;: Nghiêm cấm hành vi kéo giãn hoặc cắt xén trục tung (truncated axis) để thổi phồng mức độ tăng trưởng hay che giấu sụt giảm&lt;br/&gt;• &lt;b&gt;Tiêu chuẩn Data-ink&lt;/b&gt;: Thiết kế biểu đồ rõ ràng, có đầy đủ tiêu đề, nhãn trục, đơn vị đo và chú giải nguồn số liệu minh bạch&lt;br/&gt;• &lt;b&gt;Trách nhiệm giải trình&lt;/b&gt;: Người làm thống kê có nghĩa vụ trình bày cả bảng số liệu gộp và bảng phân rã khi có nghi ngờ về biến ẩn" vertex="1">
          <mxGeometry height="180" width="380" x="2420" y="1060" as="geometry" />
        </mxCell>

        <!-- E5 Internal Hierarchy Edges -->
        <mxCell id="E5_EDGE_1" edge="1" parent="1" source="E5_HEADER" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1B5E20;strokeWidth=1.5;curved=0;exitX=0.2;exitY=1;entryX=0.5;entryY=0;" target="E5_CARD_1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="E5_EDGE_2" edge="1" parent="1" source="E5_HEADER" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1B5E20;strokeWidth=1.5;curved=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="E5_CARD_2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="E5_EDGE_3" edge="1" parent="1" source="E5_HEADER" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1B5E20;strokeWidth=1.5;curved=0;exitX=0.8;exitY=1;entryX=0.5;entryY=0;" target="E5_CARD_3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ========================================== -->
        <!-- CROSS-ENTITY CONNECTORS (THE 7 RELATIONSHIPS) -->
        <!-- Zero card overlap, pill-badge labels          -->
        <!-- ========================================== -->

        <!-- 1. E1 -> E3: Thang đo Nominal/Ordinal định tuyến vào Bảng tần số & Biểu đồ Thanh, Tròn -->
        <mxCell id="CROSS_E1_E3" edge="1" parent="1" source="E1_HEADER" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0D47A1;strokeWidth=2;fontSize=10;fontFamily=Helvetica;curved=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;labelBackgroundColor=#ffffff;spacing=4;" target="E3_HEADER" value="Thang đo Nominal / Ordinal định tuyến&lt;br/&gt;Tổ chức Bảng tần số &amp;amp; Biểu đồ Thanh, Tròn">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 2. E1 -> E6: Thang đo Interval/Ratio định tuyến vào Quy trình lập lớp & Histogram, Ogive (Left Margin Highway: x = 1010) -->
        <mxCell id="CROSS_E1_E6" edge="1" parent="1" source="E1_HEADER" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#006064;strokeWidth=2;fontSize=10;fontFamily=Helvetica;curved=0;exitX=0;exitY=0.5;entryX=0;entryY=0.5;labelBackgroundColor=#ffffff;spacing=4;" target="E6_HEADER" value="Thang đo Interval / Ratio định tuyến&lt;br/&gt;Quy trình 3 bước lập lớp &amp;amp; Histogram, Ogive">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1010" y="268" />
              <mxPoint x="1010" y="628" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 3. E3 -> E7: Dữ liệu định tính kết hợp chéo thành Bảng chéo (Central Corridor Highway: x = 2240) -->
        <mxCell id="CROSS_E3_E7" edge="1" parent="1" source="E3_HEADER" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#BF360C;strokeWidth=2;dashed=1;fontSize=10;fontFamily=Helvetica;curved=0;exitX=0;exitY=0.8;entryX=0.25;entryY=0;labelBackgroundColor=#ffffff;spacing=4;" target="E7_HEADER" value="Dữ liệu định tính kết hợp chéo&lt;br/&gt;Thiết lập Bảng chéo (Crosstabulation)">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="2240" y="284" />
              <mxPoint x="2240" y="560" />
              <mxPoint x="2695" y="560" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 4. E6 -> E7: Biến định lượng kết hợp tương quan vào Scatter & Bảng chéo (Horizontal Bridge) -->
        <mxCell id="CROSS_E6_E7" edge="1" parent="1" source="E6_HEADER" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#BF360C;strokeWidth=2;fontSize=10;fontFamily=Helvetica;curved=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;labelBackgroundColor=#ffffff;spacing=4;" target="E7_HEADER" value="Biến định lượng kết hợp tương quan&lt;br/&gt;Đồ thị phân tán (Scatter) &amp;amp; Bảng chéo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 5. E6 -> E5: Histogram & Phân phối định lượng phục vụ SQC sản xuất (Central Corridor to E5 Top-Left) -->
        <mxCell id="CROSS_E6_E5" edge="1" parent="1" source="E6_HEADER" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#006064;strokeWidth=2;fontSize=10;fontFamily=Helvetica;curved=0;exitX=1;exitY=0.75;entryX=0.25;entryY=0;labelBackgroundColor=#ffffff;spacing=4;" target="E5_HEADER" value="Histogram &amp;amp; Phân phối định lượng&lt;br/&gt;Kiểm soát chất lượng quy trình sản xuất (SQC)">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="2160" y="641" />
              <mxPoint x="2160" y="920" />
              <mxPoint x="2080" y="920" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 6. E7 -> E5: Bảng chéo & Bài học Nghịch lý Simpson dẫn dắt quyết định quản trị (Central Corridor to E5 Top-Right) -->
        <mxCell id="CROSS_E7_E5" edge="1" parent="1" source="E7_HEADER" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#BF360C;strokeWidth=2.5;fontSize=10;fontFamily=Helvetica;curved=0;exitX=0;exitY=0.75;entryX=0.75;entryY=0;labelBackgroundColor=#ffffff;spacing=4;" target="E5_HEADER" value="Bảng chéo &amp;amp; Bài học Nghịch lý Simpson&lt;br/&gt;Định hướng quyết định quản trị chiến lược">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="2240" y="641" />
              <mxPoint x="2240" y="920" />
              <mxPoint x="2320" y="920" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 7. E5 -> E1: Chuẩn mực đạo đức trực quan hóa bảo đảm trung thực thang đo (Right Margin Highway: x = 3390) -->
        <mxCell id="CROSS_E5_E1" edge="1" parent="1" source="E5_HEADER" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1B5E20;strokeWidth=2;dashed=1;fontSize=10;fontFamily=Helvetica;curved=0;exitX=1;exitY=0.5;entryX=0.5;entryY=0;startArrow=classic;startFill=1;labelBackgroundColor=#ffffff;spacing=4;" target="E1_HEADER" value="Chuẩn mực đạo đức trực quan hóa&lt;br/&gt;Bảo đảm trung thực dữ liệu &amp;amp; Tránh bóp méo">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="3390" y="988" />
              <mxPoint x="3390" y="200" />
              <mxPoint x="1600" y="200" />
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
